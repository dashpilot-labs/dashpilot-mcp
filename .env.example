# DashPilot MCP — example configuration.
# Copy to .env, fill in your values, keep it out of version control.
# Real environment variables win over this file.

# --- DashPilot Cloud ---------------------------------------------------------
# Your DashPilot Cloud deployment.
DASHPILOT_API_URL=http://localhost:8790
# Your install key — issued by DashPilot Cloud when you register
# (POST /v1/installs/register), shown exactly once. The server keeps only a hash.
DASHPILOT_API_KEY=dp_your_issued_key

# --- DoorDash Drive access key (from the Developer Portal; sandbox works) ---
DASHPILOT_DRIVE_DEVELOPER_ID=dd_dev_…
DASHPILOT_DRIVE_KEY_ID=dd_key_…
DASHPILOT_DRIVE_KEY=…

# --- optional tuning ----------------------------------------------------------
# Bootstrap Drive endpoint (defaults to the real Drive API; local dev only:
# http://localhost:8790/drive-sim/drive/v2 — loopback http is allowed)
#DASHPILOT_DRIVE_BASE_URL=https://openapi.doordash.com/drive/v2
# managed (default) = follow DashPilot Cloud's routing; manual = pin the URL above
#DASHPILOT_DRIVE_ROUTING=managed
# how old client config may be before a refresh (seconds)
#DASHPILOT_CONFIG_TTL_SECONDS=300
# per-request timeout (seconds)
#DASHPILOT_TIMEOUT_S=15
# display name for support tickets ("Tony's Pizzeria register 2")
#DASHPILOT_SUPPORT_TAG=counter-1
# where the once-a-day diagnostics check-in state lives
#DASHPILOT_STATE_FILE=~/.dashpilot/state.json